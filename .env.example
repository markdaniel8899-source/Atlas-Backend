# ATLAS backend environment
# Copy to backend/.env and fill real values. Never commit backend/.env.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------------------------------------------------------------------------
# App / CORS
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173
SITE_URL=https://atlas-frontend-pearl.vercel.app
ADMIN_SECRET=<long-random-secret-for-cron-and-scripts>

# ---------------------------------------------------------------------------
# Blog writer providers (first configured provider in the stage chain wins;
# missing keys are skipped, retryable failures fall through)
# ---------------------------------------------------------------------------
# Writer chain: Gemini -> NVIDIA -> SambaNova -> OpenRouter
GEMINI_API_KEY=
# Legacy alias: GOOGLE_API_KEY is used when GEMINI_API_KEY is empty.
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_BLOG_MODEL=gemini-3.8-flash

NVIDIA_API_KEY=
# Legacy alias: NEMOTRON_API_KEY is used when NVIDIA_API_KEY is empty.
NEMOTRON_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BLOG_MODEL=nvidia/nemotron-3-ultra-550b-a55b

SAMBANOVA_API_KEY=
# Legacy alias: SAMBA_API_KEY is used when SAMBANOVA_API_KEY is empty.
SAMBA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_BLOG_MODEL=gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_BLOG_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_AUTO_MODEL=openrouter/free

# Blog topic/keyword stages also use Groq first when this key is present.
GROQ_BLOG_API_KEY=
# Legacy alias: GROQ_API_KEY is used when GROQ_BLOG_API_KEY is empty.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_BLOG_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Research + media
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
PIXABAY_API_KEY=

# Cloudflare R2 (durable cover/content storage)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=atlas-blog-images
R2_PUBLIC_URL=https://pub-<public-bucket-id>.r2.dev

# ---------------------------------------------------------------------------
# Publishing + automation
# ---------------------------------------------------------------------------
VERCEL_DEPLOY_HOOK_URL=
BLOG_PIPELINE_ENABLED=true
BLOG_DAILY_ARTICLE_LIMIT=1
BLOG_CRON_ENABLED=true
BLOG_CRON_HOUR_UTC=9
BLOG_CRON_MINUTE_UTC=0

# ---------------------------------------------------------------------------
# Pipeline guardrails / timeouts
# ---------------------------------------------------------------------------
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=1
BLOG_WRITER_TIMEOUT_SECONDS=300
BLOG_MIN_WORDS=900
BLOG_MAX_WORDS=2200
BLOG_MIN_SCORE=90
BLOG_MAX_REPAIRS=2
BLOG_VISUAL_WORD_THRESHOLD=1200
