# Cloudflare R2 (durable blog cover storage)
# Copy these keys into backend/.env and replace the placeholders with the
# values from the R2 dashboard. Never commit real credentials.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=atlas-blog-images
R2_PUBLIC_URL=https://pub-<public-bucket-id>.r2.dev

# AutoBlog providers (aliases are accepted)
# NEMOTRON_API_KEY falls back to NVIDIA_API_KEY
# GEMINI_API_KEY falls back to GOOGLE_API_KEY
# GROQ_BLOG_API_KEY falls back to GROQ_API_KEY
NEMOTRON_API_KEY=
GEMINI_API_KEY=
GROQ_BLOG_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
PIXABAY_API_KEY=

# Dynamic pipeline publishing
SITE_URL=https://atlas-frontend-pearl.vercel.app
VERCEL_REVALIDATE_URL=
VERCEL_REVALIDATE_SECRET=
VERCEL_DEPLOY_HOOK_URL=
