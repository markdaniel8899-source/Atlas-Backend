# ── Auto AI Blog pipeline — these are the ONLY required keys ───────────────

# Google AI Studio (Gemini 3.8 Flash writes ONLY the final article — 1 call/run)
# → https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# NVIDIA NIM (hybrid pipeline: topic/keywords/meta chunks — free tier)
# → https://build.nvidia.com (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
# Optional overrides:
# NVIDIA_BLOG_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

# Tavily Search (trending-topic research)
# → https://app.tavily.com
TAVILY_API_KEY=

# Supabase — project URL + keys
# → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: SERVER SIDE ONLY, never ship to the frontend.
# The pipeline needs it to INSERT into blog_posts (RLS bypass).
SUPABASE_SERVICE_ROLE_KEY=

# Optional override — defaults to gemini-3.8-flash:
# GOOGLE_BLOG_MODEL=gemini-3.5-flash

# Optional — chat/quiz/roadmap routes (not needed for the blog pipeline):
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ZEN_API_KEY=
# ZEN_BASE_URL=https://opencode.ai/zen/v1
# ALLOWED_ORIGINS=http://localhost:5173
