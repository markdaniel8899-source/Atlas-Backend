# ─── ATLAS Backend — environment template ────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# ── Chat / Quiz / Roadmap (main assistant — uses GROQ_API_KEY ONLY) ──────────
GROQ_API_KEY=gsk_replace_me
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=replace_me
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=1

# ── Auto Blog — WRITER (step 3 meta + step 4 article) ────────────────────────
# DEDICATED key — deliberately NOT GROQ_API_KEY so blog traffic can never
# starve Chat/Quiz. Create one at https://console.groq.com/keys
GROQ_BLOG_API_KEY=gsk_replace_me
# NOTE: the originally requested `llama-3.1-70b-versatile` (and its
# replacement `llama-3.3-70b-versatile`) were decommissioned by Groq —
# `openai/gpt-oss-120b` is the live equivalent and the default.
GROQ_BLOG_MODEL=openai/gpt-oss-120b

# ── Auto Blog — Gemini FALLBACK (step 3/4 only, on Groq 429/5xx) ─────────────
# Optional: if unset, a Groq rate limit aborts the run instead of retrying.
GOOGLE_API_KEY=replace_me
GOOGLE_BLOG_MODEL=gemini-3.8-flash

# ── Auto Blog — RESEARCH (step 1 topic + step 2 keywords) ────────────────────
NVIDIA_API_KEY=nvapi_replace_me
NVIDIA_BLOG_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
TAVILY_API_KEY=tvly_replace_me

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
# Required to SAVE posts (service-role key bypasses RLS) → blog_ready gate.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ── Server ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
